{
  "$schema": "../schemas/provider.schema.json",
  "id": "ggcoder",
  "name": "OG Coder",
  "version": "1.0.0",
  "description": "OG Coder, and the GG Coder it forks. Speaks ACP natively over stdio - no adapter process.",
  "distribution": {
    "type": "command",
    "command": "ogcoder",
    "args": ["acp"]
  },
  "repository": "https://github.com/kenkaiiii/gg-framework",
  "authors": ["kenkaiiii"],
  "license": "MIT",
  "pew": {
    "transport": "acp",
    "color": "#4ade80",
    "requiresCommand": ["ogcoder", "ggcoder"],
    "commandDirs": [".gg/commands", "~/.gg/commands"]
  }
}
